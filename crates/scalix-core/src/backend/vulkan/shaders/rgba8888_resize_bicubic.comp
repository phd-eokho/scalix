#version 450
layout(local_size_x = 64) in;

// NOTE (Reference Implementation):
// Direct 32-bit RGBA8888 / BGRA8888 Bicubic Resampling Compute Kernel using Catmull-Rom spline (Keys, 1981, a = -0.5).
// Reference: Keys, R. (1981). "Cubic convolution interpolation for digital image processing",
// IEEE Transactions on Acoustics, Speech, and Signal Processing, 29(6), 1153-1160.
// Interpolates RGBA 4-channel values across a 4x4 kernel window using hardware-accelerated pack/unpack intrinsics.

layout(set = 0, binding = 0) readonly buffer SrcBuffer { uint src_data[]; };
layout(set = 0, binding = 1) buffer DstBuffer { uint dst_data[]; };

layout(push_constant) uniform PushConsts {
    uint src_w;
    uint src_h;
    uint dst_w;
    uint dst_h;
    float scale_x;
    float scale_y;
};

vec4 fetch_raw_rgba(int px, int py) {
    int cx = clamp(px, 0, int(src_w) - 1);
    int cy = clamp(py, 0, int(src_h) - 1);
    return unpackUnorm4x8(src_data[uint(cy) * src_w + uint(cx)]);
}

// Branchless Catmull-Rom cubic weights evaluation (a = -0.5)
void eval_bicubic_weights(float f, out float w[4]) {
    float f2 = f * f;
    float f3 = f2 * f;
    w[0] = -0.5 * f3 + f2 - 0.5 * f;
    w[1] = 1.5 * f3 - 2.5 * f2 + 1.0;
    w[2] = -1.5 * f3 + 2.0 * f2 + 0.5 * f;
    w[3] = 0.5 * f3 - 0.5 * f2;
}

uint sample_bicubic_coord(uint dx, uint dy) {
    float u = (float(dx) + 0.5) * scale_x - 0.5;
    float v = (float(dy) + 0.5) * scale_y - 0.5;

    int x0 = int(floor(u));
    int y0 = int(floor(v));

    float fx = u - float(x0);
    float fy = v - float(y0);

    float wx[4];
    eval_bicubic_weights(fx, wx);

    float wy[4];
    eval_bicubic_weights(fy, wy);

    vec4 col = vec4(0.0);
    for (int j = 0; j < 4; ++j) {
        vec4 row_col = vec4(0.0);
        for (int i = 0; i < 4; ++i) {
            row_col += wx[i] * fetch_raw_rgba(x0 - 1 + i, y0 - 1 + j);
        }
        col += wy[j] * row_col;
    }

    return packUnorm4x8(clamp(col, 0.0, 1.0));
}

void main() {
    uint chunk_idx = gl_GlobalInvocationID.x;
    uint total_dst_pixels = dst_w * dst_h;
    uint base_pixel = chunk_idx * 4u;
    if (base_pixel >= total_dst_pixels) return;

    uint dx0 = base_pixel % dst_w;
    uint dy0 = base_pixel / dst_w;

    // Fully unrolled 4-pixel chunk
    dst_data[base_pixel] = sample_bicubic_coord(dx0, dy0);

    uint dx1 = dx0 + 1u;
    uint wrap1 = uint(dx1 >= dst_w);
    dx1 -= wrap1 * dst_w;
    uint dy1 = dy0 + wrap1;
    if (base_pixel + 1u < total_dst_pixels) {
        dst_data[base_pixel + 1u] = sample_bicubic_coord(dx1, dy1);
    }

    uint dx2 = dx0 + 2u;
    uint wrap2 = uint(dx2 >= dst_w);
    dx2 -= wrap2 * dst_w;
    uint dy2 = dy0 + wrap2;
    if (base_pixel + 2u < total_dst_pixels) {
        dst_data[base_pixel + 2u] = sample_bicubic_coord(dx2, dy2);
    }

    uint dx3 = dx0 + 3u;
    uint wrap3 = uint(dx3 >= dst_w);
    dx3 -= wrap3 * dst_w;
    uint dy3 = dy0 + wrap3;
    if (base_pixel + 3u < total_dst_pixels) {
        dst_data[base_pixel + 3u] = sample_bicubic_coord(dx3, dy3);
    }
}
