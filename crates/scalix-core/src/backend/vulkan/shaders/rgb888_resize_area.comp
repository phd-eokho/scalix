#version 450
layout(local_size_x = 64) in;

// NOTE (Reference Implementation):
// Direct 24-bit packed RGB888 / BGR888 Area (Box Average) Resampling Compute Kernel.
// Accurately computes exact 2D pixel area overlap weights for downsampling & upsampling.

layout(set = 0, binding = 0) readonly buffer SrcBuffer { uint src_data[]; };
layout(set = 0, binding = 1) buffer DstBuffer { uint dst_data[]; };

layout(push_constant) uniform PushConsts {
    uint src_w;
    uint src_h;
    uint dst_w;
    uint dst_h;
    float scale_x;
    float scale_y;
};

// Branchless 24-bit packed RGB fetch to vec3
vec3 fetch_raw_rgb(int px, int py) {
    int cx = clamp(px, 0, int(src_w) - 1);
    int cy = clamp(py, 0, int(src_h) - 1);
    uint src_byte_offset = (uint(cy) * src_w + uint(cx)) * 3u;
    uint word_idx = src_byte_offset >> 2u;
    uint w0 = src_data[word_idx];
    uint w1 = src_data[word_idx + 1u];

    uint shift = (src_byte_offset & 3u) << 3u;
    uint shift_hi = (32u - shift) & 31u;
    uint mask_hi = uint(0) - uint(shift != 0u);
    uint val = (w0 >> shift) | ((w1 << shift_hi) & mask_hi);
    return vec3(float(val & 0xFFu), float((val >> 8u) & 0xFFu), float((val >> 16u) & 0xFFu));
}

uint sample_area_coord(uint dx, uint dy) {
    float x0 = float(dx) * scale_x;
    float x1 = float(dx + 1u) * scale_x;
    float y0 = float(dy) * scale_y;
    float y1 = float(dy + 1u) * scale_y;

    int sx_min = int(floor(x0));
    int sx_max = int(floor(x1));
    sx_max -= int(float(sx_max) == x1 && sx_max > sx_min);

    int sy_min = int(floor(y0));
    int sy_max = int(floor(y1));
    sy_max -= int(float(sy_max) == y1 && sy_max > sy_min);

    vec3 sum_col = vec3(0.0);
    float total_weight = 0.0;

    for (int sy = sy_min; sy <= sy_max; ++sy) {
        float wy = max(0.0, min(float(sy) + 1.0, y1) - max(float(sy), y0));
        for (int sx = sx_min; sx <= sx_max; ++sx) {
            float wx = max(0.0, min(float(sx) + 1.0, x1) - max(float(sx), x0));
            float w = wx * wy;
            sum_col += fetch_raw_rgb(sx, sy) * w;
            total_weight += w;
        }
    }

    vec3 col = (total_weight > 0.0) ? (sum_col / total_weight) : fetch_raw_rgb(sx_min, sy_min);
    uvec3 ucol = uvec3(clamp(col + 0.5, 0.0, 255.0));

    return ucol.r | (ucol.g << 8u) | (ucol.b << 16u);
}

void main() {
    uint chunk_idx = gl_GlobalInvocationID.x;
    uint total_dst_pixels = dst_w * dst_h;
    uint base_pixel = chunk_idx * 4u;
    if (base_pixel >= total_dst_pixels) return;

    uint dx0 = base_pixel % dst_w;
    uint dy0 = base_pixel / dst_w;

    // Fully unrolled 4-pixel chunk without dynamic arrays or branch hazards
    uint p0 = sample_area_coord(dx0, dy0);

    uint dx1 = dx0 + 1u;
    uint wrap1 = uint(dx1 >= dst_w);
    dx1 -= wrap1 * dst_w;
    uint dy1 = dy0 + wrap1;
    uint p1 = (base_pixel + 1u < total_dst_pixels) ? sample_area_coord(dx1, dy1) : 0u;

    uint dx2 = dx0 + 2u;
    uint wrap2 = uint(dx2 >= dst_w);
    dx2 -= wrap2 * dst_w;
    uint dy2 = dy0 + wrap2;
    uint p2 = (base_pixel + 2u < total_dst_pixels) ? sample_area_coord(dx2, dy2) : 0u;

    uint dx3 = dx0 + 3u;
    uint wrap3 = uint(dx3 >= dst_w);
    dx3 -= wrap3 * dst_w;
    uint dy3 = dy0 + wrap3;
    uint p3 = (base_pixel + 3u < total_dst_pixels) ? sample_area_coord(dx3, dy3) : 0u;

    // Branchless bitwise packing into 3 storage words
    uint w0 = p0 | (p1 << 24u);
    uint w1 = (p1 >> 8u) | (p2 << 16u);
    uint w2 = (p2 >> 16u) | (p3 << 8u);
    uint out_word_base = chunk_idx * 3u;

    dst_data[out_word_base + 0u] = w0;
    if (base_pixel + 1u < total_dst_pixels) dst_data[out_word_base + 1u] = w1;
    if (base_pixel + 2u < total_dst_pixels) dst_data[out_word_base + 2u] = w2;
}
